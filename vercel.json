{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "server/data/**",
      "excludeFiles": "{server/tests/**,server/scripts/**,**/*.md,**/*.txt,Docs/**,client/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
